model Complaint {
    id              Int             @id @default(autoincrement())
    title           String
    description     String?
    disturbanceType DisturbanceType
    status          ComplaintStatus @default(PENDING)
    technicianId    Int?
    technician      Technician?     @relation(fields: [technicianId], references: [id])
    scheduledAt     DateTime?
    createdAt       DateTime        @default(now())
    updatedAt       DateTime        @updatedAt
    images          Image[]
    customer        Customer?       @relation(fields: [customerId], references: [id])
    customerId      Int?
}

enum ComplaintStatus {
    PENDING // Complaint submitted, not yet handled
    IN_PROGRESS // Technician assigned & scheduled
    RESOLVED // Work done, evidence uploaded
    CANCELLED // Cancelled by customer
}

enum DisturbanceType {
    KEBOCORAN_PIPA // Kebocoran Pipa
    AIR_TIDAK_MENGALIR // Air Tidak Mengalir
    AIR_KERUH // Air Keruh
    TEKANAN_RENDAH // Tekanan Rendah
    PIPA_PECAH // Pipa Pecah
    METER_RUSAK // Meter Rusak
    LAINNYA // Lainnya
}
