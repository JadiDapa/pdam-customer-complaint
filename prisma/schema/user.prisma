model User {
  id         Int         @id @default(autoincrement())
  fullname   String
  username   String      @unique
  role       UserRole    @default(CUSTOMER)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  customer   Customer?
  technician Technician?
}

enum UserRole {
  ADMIN
  CUSTOMER
  TECHNICIAN
}
